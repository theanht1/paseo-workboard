{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["react", "node"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "index.*",
    "client/**/*.ts",
    "client/**/*.tsx",
    "server/**/*.ts",
    "tui/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
